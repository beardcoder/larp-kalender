{
  "name": "larp-kalender",
  "version": "1.0.0",
  "description": "LARP event calendar with MCP server, admin backend, iCal feeds and PWA",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun scripts/build-client.ts --watch & bun --watch src/index.ts serve",
    "start": "bun src/index.ts serve",
    "build:client": "bun scripts/build-client.ts",
    "build:server": "bun build --compile --minify --sourcemap --compile-exec-argv=--smol src/index.ts --outfile dist/larp-kalender",
    "build": "bun run build:client && bun run build:server",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "elysia": "^1.4.30",
    "motion": "^14.9.0",
    "preact": "^11.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@types/bun": "^1.4.4",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
